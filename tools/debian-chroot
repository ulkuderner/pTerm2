#!/usr/bin/env python3
"""Unpack a mini Debian arm64 root into Build/debian-root.

iPadOS denies chroot(2) and will not execute these Linux ELF files.
The tree is the filesystem the shell can show and keep packages in.
"""

import json
import os
import sys
import tarfile
import urllib.request

REPO = "library/debian"
TAG = "bookworm-slim"
DEST = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "Build", "debian-root"))
REGISTRY = "https://registry-1.docker.io/v2"


def fetch(url, headers):
    request = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(request) as response:
        return response.read(), response.headers


def token():
    url = (
        "https://auth.docker.io/token?service=registry.docker.io"
        f"&scope=repository:{REPO}:pull"
    )
    body, _ = fetch(url, {})
    return json.loads(body)["token"]


def manifest(path, accept, auth):
    body, _ = fetch(f"{REGISTRY}/{path}", {"Authorization": f"Bearer {auth}", "Accept": accept})
    return json.loads(body)


def main():
    auth = token()
    index = manifest(
        f"{REPO}/manifests/{TAG}",
        "application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json",
        auth,
    )
    arm = next(
        item for item in index["manifests"]
        if item.get("platform", {}).get("architecture") == "arm64"
        and item.get("platform", {}).get("os") == "linux"
    )
    digest = arm["digest"]
    image = manifest(
        f"{REPO}/manifests/{digest}",
        ", ".join([
            "application/vnd.oci.image.manifest.v1+json",
            "application/vnd.docker.distribution.manifest.v2+json",
        ]),
        auth,
    )
    os.makedirs(DEST, exist_ok=True)
    for layer in image["layers"]:
        blob = layer["digest"]
        print(f"layer {blob}", flush=True)
        body, _ = fetch(
            f"{REGISTRY}/{REPO}/blobs/{blob}",
            {"Authorization": f"Bearer {auth}"},
        )
        with tarfile.open(fileobj=__import__("io").BytesIO(body), mode="r:*") as archive:
            for member in archive.getmembers():
                name = member.name.lstrip("./")
                if name.startswith("/") or any(part == ".." for part in name.split("/")):
                    raise SystemExit(f"refusing archive path {member.name}")
            archive.extractall(DEST, filter="fully_trusted")
    print(DEST)


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"debian-chroot: {error}", file=sys.stderr)
        sys.exit(1)
